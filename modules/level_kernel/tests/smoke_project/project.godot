; Engine configuration file.
; Self-contained headless project for the level_kernel LE0/LE1 smoke test.

config_version=5

[application]

config/name="Level Kernel Smoke"

[debug]

file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false

[network]

tls/certificate_bundle_override="res://../../../../thirdparty/certs/ca-bundle.crt"

[rendering]

renderer/rendering_method="gl_compatibility"
