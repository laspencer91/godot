; WP17 Fast Texture overlay editor-smoke project variant.
config_version=5

[application]

config/name="fast-texture-smoke"
config/features=PackedStringArray("4.8", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/fast_texture_smoke/plugin.cfg")

[network]

tls/certificate_bundle_override="res://ca-bundle.crt"
