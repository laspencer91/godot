; LE1 transform/extrude editor-smoke project variant.
config_version=5

[application]

config/name="transform-smoke"
config/features=PackedStringArray("4.8", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/transform_smoke/plugin.cfg")

[network]

tls/certificate_bundle_override="res://ca-bundle.crt"
