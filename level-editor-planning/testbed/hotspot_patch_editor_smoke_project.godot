; WP21 HotspotAtlas patch-editor document smoke project variant.
config_version=5

[application]

config/name="hotspot-patch-editor-smoke"
config/features=PackedStringArray("4.8", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/hotspot_patch_editor_smoke/plugin.cfg")

[network]

tls/certificate_bundle_override="res://ca-bundle.crt"
