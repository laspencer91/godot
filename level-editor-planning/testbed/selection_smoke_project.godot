; LE1 selection editor-smoke project variant. run_smoke.sh copies the testbed before using it.
config_version=5

[application]

config/name="selection-smoke"
config/features=PackedStringArray("4.8", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/selection_smoke/plugin.cfg")

[network]

tls/certificate_bundle_override="res://ca-bundle.crt"
